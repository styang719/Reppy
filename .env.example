# Safe to ship in the client — protected by Row Level Security, not secrecy.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# NOTE: OPENAI_API_KEY and the Supabase service_role key are NOT listed here.
# They are server-side only. Set them as Edge Function secrets:
#   npx supabase secrets set OPENAI_API_KEY=sk-...
# Anything with an EXPO_PUBLIC_ prefix is compiled into the app bundle and is
# extractable from a shipped build. Never put a secret behind that prefix.
