{
  "expo": {
    "name": "Reppy",
    "slug": "reppy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reppy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.styang719.reppy",
      "infoPlist": {
        "NSCameraUsageDescription": "Reppy uses your camera to identify gym equipment from a photo."
      }
    },
    "android": {
      "package": "com.styang719.reppy",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Reppy uses your camera to identify gym equipment from a photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
