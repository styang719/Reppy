{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // scripts/ runs on Node and supabase/functions/ on Deno; both are typechecked
  // by their own config, since neither shares React Native's type environment.
  "exclude": ["node_modules", "supabase/functions", "scripts"]
}
